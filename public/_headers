/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Every filename under /_next/static/ contains a content hash, so the bytes behind a
# given URL can never change. Without this rule Cloudflare Pages serves the JS and CSS
# with max-age=0 and each navigation pays a revalidation round trip per chunk — cheap on
# a direct connection, the dominant cost through a high-latency VPN hop.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The icon font's name is stable, so it can't be immutable — adding an icon rewrites the
# same URL. 30 days plus stale-while-revalidate means it's served from cache instantly and
# refreshed in the background, so a new icon appears on the visit after a deploy.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.woff2
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# The tab and home-screen icons. Short, and deliberately without stale-while-revalidate:
# these URLs can't be versioned — Safari probes /favicon.ico at the origin root on its own
# — so a long stale window would pin whatever entry a browser already has, including a
# failed one, on the asset whose failure mode is "nothing you deploy fixes it".
#
# Full paths, not wildcards. `/favicon.*` matches nothing — Pages honours a `*` that
# stands for a whole trailing segment, not one spliced into a filename — so that rule was
# inert and these files were picked up by `/:locale` below, since a placeholder matches
# any single root-level segment. The tell if it regresses: fetch /manifest.webmanifest and
# look for two Cache-Control values concatenated, because Pages appends on every match.
/favicon.ico
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/icon-192.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/icon-512.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/og-image.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/og-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# Tool and blog pages, and the `.txt` RSC payloads that sit alongside them and are
# refetched on every client-side navigation.
/:locale/tools/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/blog/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The listing and standalone pages, which the two rules above do NOT cover — `/blog/*`
# needs a segment after `blog`, so /en/blog itself fell through to no rule at all and was
# served must-revalidate. A placeholder is safe here, pinned by a literal second segment.
/:locale/blog
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/blog.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/privacy
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/privacy.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/terms
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/terms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Locale home pages, and the `.txt` RSC payloads beside them. Short browser TTL because
# this is the most-linked entry point, long stale window so the edge answers immediately.
# Enumerated rather than `/:locale`, which would also match every root-level file the site
# ships, favicons included — see the note above the icons.
/en
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-cn
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-tw
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-hk
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/es
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/ja
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/en.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-cn.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-tw.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-hk.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/es.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/ja.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/rss+xml; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400
