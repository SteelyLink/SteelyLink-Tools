/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Every filename under /_next/static/ contains a content hash, so the bytes behind a
# given URL can never change. Without this rule Cloudflare Pages serves the JS and CSS
# with max-age=0 and each navigation pays a revalidation round trip per chunk — cheap on
# a direct connection, the dominant cost through a high-latency VPN hop.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The icon font's name is stable, so it can't be immutable — adding an icon rewrites the
# same URL. 30 days plus stale-while-revalidate means it's served from cache instantly and
# refreshed in the background, so a new icon appears on the visit after a deploy.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.woff2
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# The tab and home-screen icons. Short, and deliberately without
# stale-while-revalidate, which the rest of the static assets here do use.
#
# These are the two files the browser fetches without being asked to — Safari probes
# /favicon.ico at the origin root on its own, and iOS probes /apple-touch-icon.png — so
# they can't be versioned in the URL the way a hashed chunk can, and there's no `?v=` on
# the links any more (see the note in src/app/layout.tsx). A year of stale-while-revalidate
# on an unversioned icon means any cache entry a browser has, including an empty or failed
# one, is served for a year while the refresh happens invisibly in the background. That is
# a fine trade for a font and a bad one for the one asset whose failure mode is "the tab is
# blank and nothing you deploy fixes it".
#
# An hour, revalidated properly, costs a conditional request that Cloudflare answers with a
# 304 — a few hundred bytes — and means new artwork is everywhere within the hour.
/favicon.*
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/icon-*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/og-image.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/og-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# Tool and blog pages, and the `.txt` RSC payloads that sit alongside them and are
# refetched on every client-side navigation.
/:locale/tools/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/blog/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Locale home pages. Short browser TTL because this is the most-linked entry point, long
# stale window so the edge answers immediately.
/:locale
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/:locale.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/rss+xml; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400
