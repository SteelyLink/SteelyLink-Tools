/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Every filename under /_next/static/ contains a content hash, so the bytes behind a
# given URL can never change. Without this rule Cloudflare Pages serves the JS and CSS
# with max-age=0 and each navigation pays a revalidation round trip per chunk — cheap on
# a direct connection, the dominant cost through a high-latency VPN hop.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The icon font's name is stable, so it can't be immutable — adding an icon rewrites the
# same URL. 30 days plus stale-while-revalidate means it's served from cache instantly and
# refreshed in the background, so a new icon appears on the visit after a deploy.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.woff2
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# The tab and home-screen icons. Short, and deliberately without
# stale-while-revalidate, which the rest of the static assets here do use.
#
# These are the files a browser fetches without being asked to — Safari probes
# /favicon.ico at the origin root on its own, and iOS probes /apple-touch-icon.png — so
# they can't be versioned in the URL the way a hashed chunk can, and there's no `?v=` on
# the links any more (see the note in src/app/layout.tsx). A long stale-while-revalidate
# on an unversioned icon means any cache entry a browser has, including an empty or failed
# one, is served for that whole window while the refresh happens invisibly in the
# background. That is a fine trade for a font and a bad one for the one asset whose
# failure mode is "the tab is blank and nothing you deploy fixes it".
#
# Every path here is written out in full rather than matched with a wildcard, and that is
# load-bearing. `/favicon.*` matched nothing: Pages honours a `*` that stands for a whole
# trailing segment, not one spliced into the middle of a filename. So the rule that was
# supposed to govern these three files was inert, and what actually reached the browser
# came from the `/:locale` rule further down — a placeholder matches ANY single root-level
# segment, so `favicon.ico`, `apple-touch-icon.png` and `manifest.webmanifest` all read as
# a locale and all collected its stale-while-revalidate=604800. A week of serving whatever
# entry the browser already had, on exactly the asset that must not do that.
#
# The tell, if this ever regresses: fetch /manifest.webmanifest and look for two
# Cache-Control values concatenated in one header. Pages appends on every rule that
# matches, so a second value is a second rule you didn't intend to hit. Image types don't
# show it, because Cloudflare's zone Browser Cache TTL rewrites max-age on those.
/favicon.ico
  Cache-Control: public, max-age=3600

/favicon.png
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/icon-192.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/icon-512.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/og-image.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/og-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# Tool and blog pages, and the `.txt` RSC payloads that sit alongside them and are
# refetched on every client-side navigation.
/:locale/tools/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/blog/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The listing and standalone pages, which the two rules above do NOT cover — `/blog/*`
# needs a segment after `blog`, so /en/blog itself fell through to no cache rule at all
# and Pages served it must-revalidate, paying a round trip on every visit to the page the
# navbar links to. Found while auditing the placeholder problem above; same class of bug.
# A placeholder is safe here because it's pinned by a literal second segment.
/:locale/blog
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/blog.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/privacy
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/privacy.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/terms
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/:locale/terms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Locale home pages, and the `.txt` RSC payloads beside them. Short browser TTL because
# this is the most-linked entry point, long stale window so the edge answers immediately.
#
# The six locales are enumerated rather than written as `/:locale`, because a placeholder
# matches any single root-level segment — which meant this rule was also the one governing
# every root-level file the site ships, favicons included. See the note above the icons.
/en
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-cn
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-tw
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-hk
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/es
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/ja
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/en.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-cn.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-tw.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/zh-hk.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/es.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/ja.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/rss+xml; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400
