# dependencies
node_modules/

# next.js build
.next/
out/

# typescript incremental cache — regenerated by every type check, and a 300 KB diff
# every time it is, which buries the real change
*.tsbuildinfo

# env
.env
.env.local
.env.production.local

# debug
npm-debug.log*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# claude code
.claude/

# copied out of node_modules by scripts/copy-vendor.mjs on every build
public/pdfjs/
public/vendor/

# written by scripts/generate-static.mjs on every build, from the tool registry and the
# blog index — the script is the source, these are its output. Tracking them lets the two
# drift, and sitemap.xml restamps 1398 <lastmod> dates on every run, so a one-line code
# change arrives as a 2796-line diff.
public/sitemap.xml
public/feed.xml
public/robots.txt
public/manifest.webmanifest
